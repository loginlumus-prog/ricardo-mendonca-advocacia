rules_version = '2';

// ============================================================
// REGRAS DO STORAGE — capas dos artigos
// Mesma lista de e-mails de firestore.rules. Mantenha as duas iguais.
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {

    function ehEditor() {
      return request.auth != null
        && request.auth.token.email in [
             '<EMAIL_DO_ADMIN>'
           ];
    }

    match /capas/{arquivo} {
      // a capa aparece no site público, então a leitura é aberta
      allow read: if true;

      // só imagem, só até 5 MB — o painel já barra antes, mas a regra
      // é quem garante, porque o painel roda no navegador de quem usa
      allow create, update: if ehEditor()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // separado do create: numa exclusão request.resource não existe,
      // e a checagem de tamanho acima falharia
      allow delete: if ehEditor();
    }

    match /{todo=**} {
      allow read, write: if false;
    }
  }
}
